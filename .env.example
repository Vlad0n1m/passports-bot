BOT_TOKEN=your_telegram_bot_token
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=google/gemini-2.5-flash

# Путь к JSON-ключу сервисного аккаунта Google (по умолчанию service_account.json в корне проекта)
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json
# Необязательно: ID существующей Google-таблицы, в которую добавлять листы.
# Если не задан — бот будет создавать новую таблицу на каждую сессию.
GOOGLE_SPREADSHEET_ID=
